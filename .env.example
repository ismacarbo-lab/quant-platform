# Copy to .env and adjust for local development only.
# Values below are fictional. Never put real credentials, API keys, or tokens here.

# research = data + research tooling only (safe default; tests assume it).
# paper    = adds the simulated paper-trading engine (fictional money).
#            `make app` and `make paper-run` set APP_MODE=paper explicitly.
# live is not implemented and is rejected.
APP_MODE=research

LOG_LEVEL=INFO

# PostgreSQL (SQLAlchemy 2.x + psycopg3). Do not use sqlite://
# User/password are local-development placeholders, not production secrets.
DATABASE_URL=postgresql+psycopg://quant:quant_dev_only_not_for_production@127.0.0.1:5434/quant_platform

# Market data source name stored with every bar (Yahoo Finance via yfinance,
# free, no account, no API key).
MARKET_DATA_SOURCE_NAME=yfinance

# Paper trading (fictional cash). One account per strategy is created on the
# first run so the dashboard can compare them.
PAPER_INITIAL_CASH=100000
PAPER_DEFAULT_STRATEGIES=inverse_volatility,trend_following,relative_momentum_top_n,dual_momentum,sixty_forty,buy_and_hold
PAPER_REBALANCE=monthly
PAPER_COMMISSION_BPS=1
PAPER_SLIPPAGE_BPS=5

# Built dashboard served by the API (relative to the repo root).
DASHBOARD_DIST_DIR=dashboard/dist
